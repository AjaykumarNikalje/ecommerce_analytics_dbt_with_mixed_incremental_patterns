        CREATE STREAMING TABLE `ecommerce_analytics_poc`.`ecommerce`.`bronze_orders`
    
  (
    
      `order_id` string,
    
      `customer_id` string,
    
      `order_amount` string,
    
      `order_status` string,
    
      `order_date` string,
    
