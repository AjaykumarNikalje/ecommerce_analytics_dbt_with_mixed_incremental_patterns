21:51:04.521969 [debug] [Thread-3 (]: On model.e_commerce.silver_orders: /* {"app": "dbt", "dbt_version": "1.12.5", "dbt_databricks_version": "1.12.8", "databricks_sql_connector_version": "4.4.0", "profile_name": "ecommerce_dbt_project_final", "target_name": "dev", "invocation_id": "85a55900-a1c4-41af-9020-4323acfcee0c", "node_id": "model.e_commerce.silver_orders"} */

  
    create or replace temporary view `silver_orders__dbt_tmp` as
      with

checkpoint_state as (
    
    select timestamp_micros(1795263649531000)
        as last_successful_ingested_at
    
),
upper_bound as (
    
    select timestamp_micros(1795268916668000)
        as upper_watermark
    
),

windowed_events as (
    select bronze.*
    from `ecommerce_analytics_poc`.`ecommerce`.`bronze_orders` as bronze
    
    cross join checkpoint_state
    cross join upper_bound
    where bronze.bronze_ingested_at <= upper_bound.upper_watermark
        and (
            checkpoint_state.last_successful_ingested_at is null
            or bronze.bronze_ingested_at >
                checkpoint_state.last_successful_ingested_at - interval 6 hours
        )
    
),
typed_events as (
    select distinct
        try_cast(order_id as bigint) as order_id,
        try_cast(customer_id as bigint) as customer_id,
        try_cast(order_amount as decimal(18,2)) as order_amount,
        order_status,
        try_cast(order_date as date) as order_date,
        try_cast(source_created_at as timestamp) as source_created_at,
        try_cast(source_updated_at as timestamp) as source_updated_at,
        cdc_operation
    from windowed_events
),
ranked_events as (
    select
        *,
        row_number() over (
            partition by order_id
            order by source_updated_at desc
        ) as event_rank
    from typed_events
    
),
winning_events as (
    select *
    from ranked_events
    where event_rank = 1
)

select
    winner.order_id,
    winner.customer_id,
    winner.order_amount,
    winner.order_status,
    winner.order_date,
    winner.source_created_at,
    winner.source_updated_at,
    winner.cdc_operation,
    (winner.cdc_operation = 'DELETE') as is_deleted,
    current_timestamp() as silver_created_at,
    current_timestamp() as silver_updated_at
from winning_events as winner
  
